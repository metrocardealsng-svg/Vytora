+function findFood(name: string) {
+  const q = name.toLowerCase();
+  const words = q.split(/[^a-z]+/).filter((w) => w.length > 2);
+  let best: (typeof NIGERIAN_FOODS)[number] | null = null;
+  let bestScore = 0;
+  for (const f of NIGERIAN_FOODS) {
+    const n = f.name.toLowerCase();
+    const score = words.reduce((s, w) => s + (n.includes(w) ? 1 : 0), 0) + (n.startsWith(q) ? 2 : 0);
+    if (score > bestScore) {
+      best = f;
+      bestScore = score;
+    }
+  }
+  return bestScore > 0 ? best : null;
+}
