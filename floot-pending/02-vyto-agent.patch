+function load(): CoachMessage[] {
+  try {
+    const raw = localStorage.getItem(KEY);
+    const parsed = raw ? (JSON.parse(raw) as CoachMessage[]) : null;
+    if (Array.isArray(parsed) && parsed.length > 0) return parsed.slice(-40);
+  } catch {
+    /* ignore */
+  }
+  return [GREETING];
+}
