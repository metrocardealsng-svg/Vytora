+export async function runCoach(opts: { user: User | null; messages: Msg[]; tz: string }): Promise<CoachResult> {
+  const { user, messages, tz } = opts;
+  const ctx = { actions: [] as CoachAction[], changed: new Set<string>() };
+  let instructions = BASE_PROMPT + (user ? MEMBER_PROMPT : GUEST_PROMPT);
+  if (user) {
+    const p = await db
+      .selectFrom("users")
+      .select(["displayName", "fitnessGoal", "weightKg", "heightCm", "location", "dailyStepGoal"])
+      .where("id", "=", user.id)
+      .executeTakeFirstOrThrow();
+    instructions += `\n\nMember: ${p.displayName}. Goal: ${FITNESS_GOAL_LABELS[p.fitnessGoal]}.${p.weightKg ? ` Weight ${p.weightKg} kg.` : ""}${
+      p.heightCm ? ` Height ${p.heightCm} cm.` : ""
+    }${p.location ? ` Lives in ${p.location}.` : ""} Daily step goal ${p.dailyStepGoal}. Today is ${todayInTimeZone(tz)} (${tz}).`;
+  }
+
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const input: any[] = messages.slice(-14).map((m) => ({ type: "message", role: m.role, content: m.content }));
+  for (let round = 0; round < 6; round++) {
+    const r = await flootAi.chat({
+      model: "gpt-6-luna",
+      instructions,
+      input,
+      ...(user ? { tools: TOOLS } : {}),
+      reasoning: { effort: "low" },
+      max_output_tokens: 1400,
+    });
+    const output = (r.output ?? []) as OutItem[];
+    const calls = output.filter((o) => o.type === "function_call");
+    if (calls.length === 0 || !user) {
+      const reply = textOf(output) || (typeof r.output_text === "string" ? r.output_text.trim() : "");
+      return { reply: reply || "I no catch that one. Try asking again?", actions: dedupe(ctx.actions), changed: [...ctx.changed] };
+    }
+    for (const c of calls) {
+      input.push({ type: "function_call", call_id: c.call_id, name: c.name, arguments: c.arguments ?? "{}" });
+      let result: unknown;
+      try {
+        result = await runTool(c.name ?? "", JSON.parse(c.arguments || "{}"), user, tz, ctx);
+      } catch (e) {
+        console.error("Vyto tool failed", c.name, e);
+        result = { error: "Tool failed. Tell the member briefly and continue." };
+      }
+      input.push({ type: "function_call_output", call_id: c.call_id, output: JSON.stringify(result) });
+    }
+  }
+  return { reply: "Done. Anything else?", actions: dedupe(ctx.actions), changed: [...ctx.changed] };
+}
+
+function dedupe(actions: CoachAction[]): CoachAction[] {
+  const seen = new Set<string>();
+  return actions.filter((a) => (seen.has(a.href) ? false : (seen.add(a.href), true))).slice(0, 3);
+}
