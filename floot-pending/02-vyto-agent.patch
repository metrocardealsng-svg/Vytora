+type OutItem = { type: string; content?: Array<{ type: string; text?: string }>; name?: string; arguments?: string; call_id?: string };
+
+function textOf(output: OutItem[]): string {
+  return output
+    .filter((o) => o.type === "message")
+    .flatMap((o) => o.content ?? [])
+    .filter((c) => c.type === "output_text" && typeof c.text === "string")
+    .map((c) => c.text as string)
+    .join("\n")
+    .trim();
+}
