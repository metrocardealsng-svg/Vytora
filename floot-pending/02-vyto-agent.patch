+export function useCoachConversation() {
+  const [messages, setMessages] = useState<CoachMessage[]>(load);
+  const [guestRemaining, setGuestRemaining] = useState<number | null>(null);
+  const chat = useCoachChat();
+  const qc = useQueryClient();
+
+  useEffect(() => {
+    try {
+      localStorage.setItem(KEY, JSON.stringify(messages.slice(-40)));
+    } catch {
+      /* ignore */
+    }
+  }, [messages]);
+
+  const send = useCallback(
+    (text: string) => {
+      const content = text.trim();
+      if (!content || chat.isPending) return;
+      const next: CoachMessage[] = [...messages, { role: "user", content }];
+      setMessages(next);
+      const history = next.filter((m) => m !== GREETING).slice(-20).map(({ role, content: c }) => ({ role, content: c }));
+      chat.mutate(
+        { messages: history },
+        {
+          onSuccess: (data) => {
+            setMessages((prev) => [...prev, { role: "assistant", content: data.reply, actions: data.actions }]);
+            setGuestRemaining(data.guestRemaining);
+            if (data.changed.length) {
+              qc.invalidateQueries({ queryKey: queryKeys.overview });
+              if (data.changed.includes("nutrition")) qc.invalidateQueries({ queryKey: queryKeys.nutritionAll });
+              if (data.changed.includes("sleep")) qc.invalidateQueries({ queryKey: queryKeys.sleep });
+            }
+          },
+          onError: (err) => {
+            if (err instanceof ApiError && err.code === "OUT_OF_CREDITS") {
+              console.warn("Vyto unavailable: out of credits");
+              setMessages((prev) => [...prev, { role: "assistant", content: "I'm resting right now. Try me again later." }]);
+              return;
+            }
+            toast.error(err instanceof Error ? err.message : "Vyto couldn't reply. Try again.");
+            setMessages((prev) => prev.slice(0, -1));
+          },
+        },
+      );
+    },
+    [messages, chat, qc],
+  );
+
+  const reset = useCallback(() => setMessages([GREETING]), []);
+
+  return { messages, send, reset, isThinking: chat.isPending, guestRemaining };
+}
