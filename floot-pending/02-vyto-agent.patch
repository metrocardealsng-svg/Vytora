+import superjson from "superjson";
+import { createHash } from "crypto";
+import { sql } from "kysely";
+import { FlootAiOutOfCreditsError, FlootAiRateLimitError } from "@floot/ai";
+import { db } from "../../helpers/db";
+import { getServerUserSession } from "../../helpers/getServerUserSession";
+import { runCoach } from "../../helpers/coachAgent";
+import { handleErrors, jsonResponse, safeTimeZone, HttpError } from "../../helpers/serverUtils";
+import { schema, type OutputType } from "./chat_POST.schema";
+
+const GUEST_LIMIT_PER_HOUR = 10;
+
+export async function handle(request: Request) {
+  return handleErrors(async () => {
+    const { messages, tz } = schema.parse(superjson.parse(await request.text()));
+    let user = null;
+    try {
+      user = (await getServerUserSession(request)).user;
+    } catch {
+      user = null;
+    }
+
+    let guestRemaining: number | null = null;
+    if (!user) {
+      const ip = request.headers.get("x-forwarded-for")?.split(",")[0]?.trim() || request.headers.get("x-real-ip") || "unknown";
+      const key = createHash("sha256").update(`${ip}|${request.headers.get("user-agent") ?? ""}`).digest("hex");
+      const row = await db
+        .insertInto("coachGuestUsage")
+        .values({ guestKey: key, windowStart: new Date(), count: 1 })
+        .onConflict((oc) =>
+          oc.column("guestKey").doUpdateSet({
+            count: sql`case when coach_guest_usage.window_start < now() - interval '1 hour' then 1 else coach_guest_usage.count + 1 end`,
+            windowStart: sql`case when coach_guest_usage.window_start < now() - interval '1 hour' then now() else coach_guest_usage.window_start end`,
+          }),
+        )
+        .returning("count")
+        .executeTakeFirstOrThrow();
+      if (row.count > GUEST_LIMIT_PER_HOUR) {
+        throw new HttpError(429, "You've used your free guest messages for this hour. Create a free account to keep chatting with Vyto.");
+      }
+      guestRemaining = GUEST_LIMIT_PER_HOUR - row.count;
+    }
+
+    try {
+      const result = await runCoach({ user, messages, tz: safeTimeZone(tz) });
+      return jsonResponse({ ...result, guestRemaining } satisfies OutputType);
+    } catch (err) {
+      if (err instanceof FlootAiOutOfCreditsError) {
+        return jsonResponse({ error: "Vyto is resting right now. Please try again later.", code: "OUT_OF_CREDITS" }, 503);
+      }
+      if (err instanceof FlootAiRateLimitError) {
+        return jsonResponse({ error: "Vyto is busy. Try again in a minute." }, 429);
+      }
+      throw err;
+    }
+  });
+}
