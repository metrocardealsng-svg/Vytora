+import { useState } from "react";
+import { Link } from "react-router-dom";
+import { Helmet } from "react-helmet";
+import { Trophy } from "lucide-react";
+import { PageHeader } from "../components/PageHeader";
+import { Button } from "../components/Button";
+import { Skeleton } from "../components/Skeleton";
+import { useRecords } from "../helpers/useVytoraData";
+import { ACTIVITY_LABELS, EFFORTS, formatDate, formatDuration, formatPace } from "../helpers/fitness";
+import type { ActivityType } from "../helpers/schema";
+import styles from "./records.module.css";
+
+const TYPES: ActivityType[] = ["run", "walk", "hike", "cycle"];
+
+export default function RecordsPage() {
+  const { data, isPending } = useRecords();
+  const [type, setType] = useState<ActivityType>("run");
+  const rows = (data ?? []).filter((r) => r.type === type);
+  const typesWithData = new Set((data ?? []).map((r) => r.type));
+
+  return (
+    <div className={styles.page}>
+      <Helmet>
+        <title>Personal Records · Vytora</title>
+      </Helmet>
+      <PageHeader
+        eyebrow="Your bests"
+        title="Personal records"
+        subtitle="Your fastest times at standard distances, found automatically inside every GPS activity. Race them from the tracker."
+        actions={
+          <Button asChild>
+            <Link to="/tracker">Race a PR</Link>
+          </Button>
+        }
+      />
+      <div className={styles.types}>
+        {TYPES.map((t) => (
+          <button key={t} type="button" className={`${styles.type} ${type === t ? styles.typeActive : ""}`} onClick={() => setType(t)}>
+            {ACTIVITY_LABELS[t]}
+            {typesWithData.has(t) && <span className={styles.dot} />}
+          </button>
+        ))}
+      </div>
+      {isPending ? (
+        <Skeleton className={styles.skel} />
+      ) : (
+        <div className={styles.grid}>
+          {EFFORTS.map((e) => {
+            const r = rows.find((x) => x.effort === e.key);
+            return (
+              <div key={e.key} className={`${styles.card} ${r ? styles.has : ""}`}>
+                <div className={styles.cardTop}>
+                  <span className={styles.label}>{e.label}</span>
+                  {r && <Trophy size={16} className={styles.trophy} />}
+                </div>
+                {r ? (
+                  <>
+                    <div className={styles.time}>{formatDuration(r.seconds)}</div>
+                    <div className={styles.meta}>
+                      {formatPace(r.seconds / (e.meters / 1000))}/km · {formatDate(r.startedAt)}
+                    </div>
+                    <div className={styles.meta}>
+                      {r.attempts} effort{r.attempts === 1 ? "" : "s"} ·{" "}
+                      <Link to={`/activities/${r.activityId}`} className={styles.link}>
+                        View activity
+                      </Link>
+                    </div>
+                  </>
+                ) : (
+                  <div className={styles.empty}>Not yet. Cover {e.label.toLowerCase()} in one GPS {ACTIVITY_LABELS[type].toLowerCase()} to set it.</div>
+                )}
+              </div>
+            );
+          })}
+        </div>
+      )}
+    </div>
+  );
+}
